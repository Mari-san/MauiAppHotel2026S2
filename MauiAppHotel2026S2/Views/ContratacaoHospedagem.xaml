<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.ContratacaoHospedagem"
             BackgroundColor="{StaticResource CorFundo}"
             Title="Hospedagem">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource CorTexto}" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource CorTexto}" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="TextColor" Value="{StaticResource CorTexto}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Margin="0,30,0,0" Spacing="2">
                <Label Text="Cálculo da Diária" Style="{StaticResource TituloPagina}" />
                <Label Text="Hotel Laguna"
                       TextColor="{StaticResource CorTextoSuave}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Cartao}">
                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value}"
                               HorizontalTextAlignment="Center"
                               BindingContext="{x:Reference stp_adultos}" />
                        <Stepper x:Name="stp_adultos" Grid.Row="0" Grid.Column="2"
                                 Minimum="1" Maximum="5" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}"
                               HorizontalTextAlignment="Center"
                               BindingContext="{x:Reference stp_criancas}" />
                        <Stepper x:Name="stp_criancas" Grid.Row="1" Grid.Column="2"
                                 Minimum="0" Maximum="5" />
                    </Grid>

                    <BoxView Style="{StaticResource Linha}" />

                    <Label Text="Selecione sua acomodação:" FontAttributes="Bold" />
                    <Picker x:Name="pck_quarto"
                            ItemDisplayBinding="{Binding Nome}"
                            Title="Selecione sua suíte..." />

                    <BoxView Style="{StaticResource Linha}" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" />
                        <DatePicker x:Name="dtpck_checkin" DateSelected="dtpck_checkin_DateSelected"
                                    Grid.Row="0" Grid.Column="1" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Check-out:" />
                        <DatePicker x:Name="dtpck_checkout" Grid.Row="1" Grid.Column="1" />
                    </Grid>

                    <Button Text="Calcular!"
                            Style="{StaticResource BotaoPrincipal}"
                            Margin="0,10,0,0"
                            Clicked="Button_Clicked" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
