<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.ContratacaoHospedagem"
             BackgroundColor="#F4F6FA"
             Title="Hospedagem">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Cálculo da Diária"
                   FontFamily="Marhey"
                   FontSize="32"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center"
                   Margin="0,30,0,10" />

            <Border BackgroundColor="White"
                    Stroke="#E3E7ED"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Offset="0,3" Radius="8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value}"
                               HorizontalTextAlignment="Center"
                               BindingContext="{x:Reference stp_adultos}" />
                        
                        <Stepper x:Name="stp_adultos" Grid.Row="0" Grid.Column="2"
                                 Minimum="1" Maximum="5" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}"
                               HorizontalTextAlignment="Center"
                               BindingContext="{x:Reference stp_criancas}" />
                        
                        <Stepper x:Name="stp_criancas" Grid.Row="1" Grid.Column="2"
                                 Minimum="0" Maximum="5" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E3E7ED" />

                    <Label Text="Selecione sua acomodação:" FontAttributes="Bold" />
                    <Picker x:Name="pck_quarto"/>

                    <BoxView HeightRequest="1" Color="#E3E7ED" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" />
                        <DatePicker x:Name="dtpck_checkin" Grid.Row="0" Grid.Column="1" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Check-out:" />
                        <DatePicker x:Name="dtpck_checkout" Grid.Row="1" Grid.Column="1" />
                    </Grid>

                    <Button Text="Calcular!"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="50"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>
