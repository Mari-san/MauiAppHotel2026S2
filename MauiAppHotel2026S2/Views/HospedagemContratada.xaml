<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.HospedagemContratada"
             BackgroundColor="{StaticResource CorFundo}"
             Title="Hospedagem Contratada">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource CorTexto}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

        <Label Text="Hospedagem Contratada" Style="{StaticResource TituloPagina}" />

        <Border Style="{StaticResource Cartao}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding QuartoEscolhido.Nome}"
                       FontSize="22"
                       FontAttributes="Bold" />

                <BoxView Style="{StaticResource Linha}" />

                <Label Text="{Binding QntAdultos, StringFormat='Adultos: {0}'}" />
                <Label Text="{Binding QntCriancas, StringFormat='Crianças: {0}'}" />
                <Label Text="{Binding DataCheckin, StringFormat='Check-in: {0:dd/MM/yyyy}'}" />
                <Label Text="{Binding DataCheckout, StringFormat='Check-out: {0:dd/MM/yyyy}'}" />
                <Label Text="{Binding Estadia, StringFormat='Diárias: {0}'}" />

                <BoxView Style="{StaticResource Linha}" />

                <Label Text="{Binding TotalHospedagem, StringFormat='Total: R$ {0:N2}'}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar"
                Style="{StaticResource BotaoPrincipal}"
                Clicked="Voltar_Clicked" />

    </VerticalStackLayout>

</ContentPage>
