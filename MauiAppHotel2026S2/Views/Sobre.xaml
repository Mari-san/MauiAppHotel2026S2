<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.Sobre"
             BackgroundColor="#F4F6FA"
             Title="Sobre">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <Label Text="Sobre"
                   FontFamily="Marhey"
                   FontSize="32"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <Border BackgroundColor="White"
                    Stroke="#E3E7ED"
                    StrokeShape="RoundRectangle 16"
                    Padding="25">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Offset="0,3" Radius="8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Label Text="Aplicativo"
                           FontSize="12"
                           TextColor="Gray" />
                    <Label Text="Hotel - Cálculo da Diária"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,-10,0,0" />

                    <BoxView HeightRequest="1" Color="LightGray" />

                    <Label Text="Desenvolvedor"
                           FontSize="12"
                           TextColor="Gray" />
                    <Label Text="Marilia André dos Santos"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,-10,0,0" />

                    <BoxView HeightRequest="1" Color="LightGray" />

                    <Label Text="Ano de desenvolvimento"
                           FontSize="12"
                           TextColor="Gray" />
                    <Label Text="2026"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,-10,0,0" />

                    <BoxView HeightRequest="1" Color="LightGray" />

                    <Label Text="Curso"
                           FontSize="12"
                           TextColor="Gray" />
                    <Label Text="Técnico em Desenvolvimento de Sistemas - ETEC"
                           FontSize="16"
                           Margin="0,-10,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
