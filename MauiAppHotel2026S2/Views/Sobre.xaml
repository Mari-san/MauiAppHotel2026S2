<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.Sobre"
             BackgroundColor="{StaticResource CorFundo}"
             Title="Sobre">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource CorTexto}" />
        </Style>
  
        <Style x:Key="Legenda" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource CorTextoSuave}" />
        </Style>

        <Style x:Key="Informacao" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,-10,0,0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <Label Text="Sobre" Style="{StaticResource TituloPagina}" />

            <Border Style="{StaticResource Cartao}" Padding="25">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Aplicativo" Style="{StaticResource Legenda}" />
                    <Label Text="Hotel - Cálculo da Diária" Style="{StaticResource Informacao}" />

                    <BoxView Style="{StaticResource Linha}" />

                    <Label Text="Desenvolvedor" Style="{StaticResource Legenda}" />
                    <Label Text="Marilia André dos Santos" Style="{StaticResource Informacao}" />

                    <BoxView Style="{StaticResource Linha}" />

                    <Label Text="Ano de desenvolvimento" Style="{StaticResource Legenda}" />
                    <Label Text="2026" Style="{StaticResource Informacao}" />

                    <BoxView Style="{StaticResource Linha}" />

                    <Label Text="Curso" Style="{StaticResource Legenda}" />
                    <Label Text="Técnico em Desenvolvimento de Sistemas - ETEC"
                           FontSize="16"
                           Margin="0,-10,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
